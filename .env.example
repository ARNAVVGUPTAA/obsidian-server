# Copy to .env and fill in. Never commit .env.

# WebDAV credentials. The server refuses to start on a default/weak value.
# Generate one with: openssl rand -base64 24
WEBDAV_USERNAME=obsidian
WEBDAV_PASSWORD=

# Cloudflare tunnel token from Zero Trust > Networks > Tunnels > your tunnel.
TUNNEL_TOKEN=

# Optional: extra CORS origins, comma-separated. Obsidian's own origins
# (app://obsidian.md, capacitor://localhost, http://localhost) are always allowed.
ALLOWED_ORIGINS=
